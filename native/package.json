{
  "name": "mamoken-ios-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build-native.mjs",
    "ios:generate": "node tools/generate-ios.mjs",
    "ios:sync": "npm run build && cap sync ios && node tools/configure-ios.mjs",
    "ios:open": "cap open ios",
    "ios:smoke": "node tools/simulator-smoke.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/preferences": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "esbuild": "0.28.2",
    "plist": "3.1.1",
    "xcode": "4.0.0"
  }
}
